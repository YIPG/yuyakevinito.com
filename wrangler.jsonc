{
  "name": "yuyakevinito-com",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "preview_urls": true,
  "dev": {
    "host": "localhost"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "yuyakevinito.com",
      "custom_domain": true
    }
  ]
}
